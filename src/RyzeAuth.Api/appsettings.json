{
  "ConnectionStrings": {
    "RyzeAuth": "Host=localhost;Port=5433;Database=ryzeauth;Username=ryzeauth;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/ryzespace",
    "AdminBaseUrl": "http://localhost:8080",
    "Realm": "ryzespace",
    "AdminClientId": "ryzeauth-admin",
    "AdminClientSecret": "CHANGE_ME_IN_ENV",
    "ValidAudience": "ryzeauth-api"
  },
  "Security": {
    "TokenDigestKey": "REPLACE_WITH_BASE64_32_BYTE_SECRET",
    "PublicResetBaseUrl": "https://auth.ryzespace.example/reset-password",
    "RequireBreachCheck": true,
    "MaximumDevicesPerUser": 5,
    "KeycloakEventSigningKey": "REPLACE_WITH_BASE64_32_BYTE_EVENT_SIGNING_SECRET"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "From": "security@ryzespace.example"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
